#!/usr/bin/env bash
# m2j - entry point for macOS/Linux development.
#
# Named m2j rather than meeting2jira because the Python package directory already owns that
# name at the repo root, and POSIX has no PATHEXT to disambiguate a file from a directory.
# On Windows the entry point is meeting2jira.cmd, so `.\meeting2jira` works there.
#
# The real tool runs on Windows: the Outlook COM export and DPAPI token storage are Windows
# only. This script covers what genuinely works off-Windows:
#
#   ./m2j selftest          run the unit tests
#   ./m2j check             verify config and Jira reachability
#   ./m2j status            last-run health, then recent sub-tasks
#   ./m2j csv <file>        push from an Outlook CSV export
#   ./m2j preview <file>    same, but create nothing
#   ./m2j cli [args]        Python CLI passthrough
#
# The Jira token must come from the JIRA_PAT environment variable here; `set-token` uses
# Windows DPAPI and refuses to run elsewhere.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"
# The Python package lives in src/. Putting it on PYTHONPATH rather than cd-ing into it keeps
# the working directory at the app root, so `unittest discover -s tests` still works.
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

PY="${PYTHON:-}"
if [ -z "$PY" ]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      PY="$candidate"
      break
    fi
  done
fi
if [ -z "$PY" ]; then
  echo "ERROR: no python3 on PATH. Set PYTHON=/path/to/python3 and retry." >&2
  exit 2
fi

usage() {
  cat <<'EOF'
m2j - meeting2jira, for development off Windows

  ./m2j selftest          run the unit tests
  ./m2j check             verify config, token and Jira access
  ./m2j status            last-run health, then recent sub-tasks
  ./m2j csv <file>        push from an Outlook CSV export
  ./m2j preview <file>    same, but create nothing
  ./m2j cli [args]        Python CLI passthrough

On Windows use meeting2jira.cmd instead: it also does the Outlook export,
the scheduled task, and DPAPI token storage.
EOF
}

action="${1:-help}"
if [ $# -gt 0 ]; then shift; fi

case "$action" in
  selftest)
    "$PY" -m unittest discover -s tests -v "$@"
    ;;
  check | status | init | forget | push)
    "$PY" -m meeting2jira "$action" "$@"
    ;;
  set-token)
    echo "set-token needs Windows DPAPI. Off Windows, export JIRA_PAT instead:" >&2
    echo "  export JIRA_PAT='your-token'" >&2
    exit 2
    ;;
  csv | preview)
    if [ $# -eq 0 ]; then
      echo "Usage: ./m2j $action <calendar.csv> [extra args]" >&2
      exit 2
    fi
    csv="$1"
    shift
    if [ "$action" = "preview" ]; then
      "$PY" -m meeting2jira push --csv "$csv" --dry-run "$@"
    else
      "$PY" -m meeting2jira push --csv "$csv" "$@"
    fi
    ;;
  cli)
    "$PY" -m meeting2jira "$@"
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "Unknown command: $action" >&2
    echo >&2
    usage >&2
    exit 2
    ;;
esac
