# Normalise text files in the repository
* text=auto

# Windows scripts must have CRLF line endings, including in GitHub's Download ZIP
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

*.ico binary
*.png binary

# Leave maintainer-only files out of downloaded zips (git archive / Download ZIP)
/tests export-ignore
/tools/make_icon.py export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.github export-ignore
/tools/check_muninn_schema.py export-ignore
/docs export-ignore
/HANDOFF.md export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/tools/baldur_smoke.sh export-ignore
